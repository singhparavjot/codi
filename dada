- script: |
    # Run the Databricks SQL file
    databricks runs submit --json '{
      "tasks": [
        {
          "task_key": "run_sql_task",
          "sql_task": {
            "query": "/Workspace/sql_db/test-query.sql"
          }
        }
      ],
      "existing_cluster_id": "your-cluster-id"
    }'
  displayName: 'Run SQL file on Databricks'
